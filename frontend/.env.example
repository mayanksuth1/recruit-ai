# Publishable (anon) key — Supabase dashboard > Settings > API Keys.
# This is the PUBLIC key (sb_publishable_... or the legacy "anon" JWT), NOT the secret key.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Production only: the deployed backend's base URL (your Render service),
# e.g. https://recruit-ai-backend.onrender.com — NO trailing slash.
# Leave BLANK for local dev (Vite proxies /api to localhost:8000).
VITE_API_URL=
