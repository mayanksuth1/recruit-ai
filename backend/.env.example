# Supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...            # server-side only, never ships to frontend

# NVIDIA NIM — the model provider (replaced Gemini). NIM speaks the OpenAI
# chat-completions API, so the client is the `openai` SDK pointed at NVIDIA.
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Default model: fast, used for everything interactive or high-volume
# (candidate scoring, outreach drafts, Boolean search, interview questions).
# Must support OpenAI-style response_format json_schema — the nemotron
# reasoning models do NOT: they return null `content`.
NVIDIA_MODEL=openai/gpt-oss-20b
NVIDIA_FALLBACK_MODEL=openai/gpt-oss-20b

# Quality model: opted into per call site, currently the LinkedIn post and the
# AI-interview transcript scoring. Far slower (~100s vs ~1s per call), so do not
# promote it to NVIDIA_MODEL without measuring first.
NVIDIA_QUALITY_MODEL=z-ai/glm-5.2

# Embeddings for semantic candidate search (Level 2).
# nv-embedqa-e5-v5 emits 1024 dimensions and ai_embeddings.embedding is
# vector(1024) to match (migration 0011). Changing the model means changing the
# column, rebuilding the HNSW index, and re-embedding everything — vectors from
# two models are not comparable even at the same width.
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_EMBEDDING_DIM=1024

# Email (Phase 3) — Resend
RESEND_API_KEY=
EMAIL_FROM=Recruit AI <onboarding@resend.dev>

# Google Calendar OAuth (Phase 4)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production: must match a redirect URI registered on the OAuth client.
# Local dev default: http://localhost:8000/api/calendar/oauth/callback
# Production example: https://recruit-ai-backend.onrender.com/api/calendar/oauth/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/calendar/oauth/callback

# Where the frontend lives — used to build candidate scheduling links.
# Local dev default: http://localhost:5173   Production: your Vercel URL.
FRONTEND_URL=http://localhost:5173

# Comma-separated allowed origins for CORS.
# Local dev: http://localhost:5173   Production: add your Vercel URL(s).
CORS_ORIGINS=http://localhost:5173

# Timezone for proposing interview slots
SCHEDULER_TIMEZONE=Asia/Kolkata

# Local development only: permits the resend.dev sandbox sender, which reaches
# nobody but the Resend account owner. Leave this unset in production.
# ALLOW_SANDBOX_EMAIL=true
